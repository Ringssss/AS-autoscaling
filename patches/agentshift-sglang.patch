+class FakeKVPool:
+    def __init__(self):
+        self.k_buffer = [torch.zeros((32, 2, 4), dtype=torch.float16)]
+        self.v_buffer = [torch.zeros((32, 2, 4), dtype=torch.float16)]
+
+
+class FakeAllocator:
+    device = "cpu"
+
+    def __init__(self):
+        self.pool = FakeKVPool()
+        self.free_slots = torch.arange(16, 32, dtype=torch.int64)
+        self.freed = []
+
+    def get_kvcache(self):
+        return self.pool
+
+    def alloc(self, count):
+        if count > len(self.free_slots):
+            return None
+        result = self.free_slots[:count]
+        self.free_slots = self.free_slots[count:]
+        return result
+
+    def available_size(self):
+        return len(self.free_slots)
+
+    def free(self, indices):
+        self.freed.extend(indices.tolist())
+        self.free_slots = torch.cat((self.free_slots, indices))
+
+
+class TestAgentPrefixManager(unittest.TestCase):
+    def setUp(self):
+        self.allocator = FakeAllocator()
+        self.cache = RadixCache.create_simulated(mock_allocator=self.allocator)
+        self.cache.insert(
+            InsertParams(
+                key=RadixKey(torch.tensor([10, 11, 12, 13]).tolist()),
+                value=torch.tensor([1, 2, 3, 4], dtype=torch.int64),
+            )
+        )
+        self.manager = AgentPrefixManager(
+            tree_cache=self.cache,
+            token_to_kv_pool_allocator=self.allocator,
+            tp_rank=0,
+            tp_size=1,
+            gpu_id=0,
+        )
+
+    def test_pin_is_idempotent_for_same_epoch(self):
+        result = self.manager.pin(
+            agent_id="agent-1", owner_epoch=4, token_ids=[10, 11, 12, 13]
+        )
+        again = self.manager.pin(
+            agent_id="agent-1", owner_epoch=4, token_ids=[10, 11, 12, 13, 99]
+        )
+        self.assertEqual(result.token_count, 4)
+        self.assertEqual(again.token_count, 4)
+        self.assertEqual(self.cache.protected_size(), 4)
+
+    def test_stale_release_is_fenced(self):
+        self.manager.pin(
+            agent_id="agent-1", owner_epoch=4, token_ids=[10, 11, 12, 13]
+        )
+        with self.assertRaisesRegex(RuntimeError, "stale prefix release"):
+            self.manager.release(agent_id="agent-1", owner_epoch=3)
+
+    def test_release_unpins_and_reclaims_cache(self):
+        self.manager.pin(
+            agent_id="agent-1", owner_epoch=4, token_ids=[10, 11, 12, 13]
+        )
+        result = self.manager.release(agent_id="agent-1", owner_epoch=4)
+        self.assertEqual(result.evicted_tokens, 4)
+        self.assertEqual(self.cache.total_size(), 0)
+
+    def test_rebind_fences_old_epoch_and_is_idempotent(self):
+        self.manager.pin(
+            agent_id="agent-1", owner_epoch=4, token_ids=[10, 11, 12, 13]
+        )
+        self.manager.rebind(
+            agent_id="agent-1", expected_owner_epoch=4, new_owner_epoch=6
+        )
+        self.manager.rebind(
+            agent_id="agent-1", expected_owner_epoch=4, new_owner_epoch=6
+        )
+        with self.assertRaisesRegex(RuntimeError, "stale prefix release"):
+            self.manager.release(agent_id="agent-1", owner_epoch=4)
+        self.manager.release(agent_id="agent-1", owner_epoch=6)
+
+    def test_allow_missing_release_is_retryable(self):
+        result = self.manager.release(
+            agent_id="missing", owner_epoch=4, allow_missing=True
+        )
+        self.assertEqual(result.token_count, 0)
+
+    def test_failed_transfer_cleanup_releases_destination_reservation(self):
+        indices = self.allocator.alloc(3)
+        self.manager.background_transfers["migration-1"] = BackgroundTransfer(
+            migration_id="migration-1",
+            role="destination",
+            agent_id="agent-1",
+            owner_epoch=5,
+            token_ids=(10, 11, 12),
+            group_name="group",
+            ports="1234",
+            extra_key=None,
+            token_count=3,
+            bytes_transferred=0,
+            destination_indices=indices,
+            state="FAILED",
+        )
+        result = self.manager.cleanup_transfer("migration-1")
+        self.assertEqual(result.token_count, 3)
+        self.assertNotIn("migration-1", self.manager.background_transfers)
+        self.assertTrue(set(indices.tolist()).issubset(self.allocator.freed))
+
+    def test_failed_tier_cleanup_releases_destination_reservation(self):
+        indices = self.allocator.alloc(3)
+        self.manager.tier_operations["tier-1"] = BackgroundTierOperation(
+            operation_id="tier-1",
+            operation="shared_import",
+            checkpoint_id="checkpoint-1",
+            agent_id="agent-1",
+            owner_epoch=5,
+            token_ids=(10, 11, 12),
+            extra_key=None,
+            release_gpu=False,
+            token_count=3,
+            bytes_transferred=64,
+            destination_indices=indices,
+            state="FAILED",
+        )
+        result = self.manager.cleanup_tier_operation("tier-1")
+        self.assertEqual(result.token_count, 3)
+        self.assertNotIn("tier-1", self.manager.tier_operations)
+        self.assertTrue(set(indices.tolist()).issubset(self.allocator.freed))
+
+    def test_tier_reservation_is_included_in_accounting(self):
+        transfer_indices = self.allocator.alloc(2)
+        tier_indices = self.allocator.alloc(3)
+        self.manager.background_transfers["migration-1"] = BackgroundTransfer(
+            migration_id="migration-1",
+            role="destination",
+            agent_id="agent-1",
+            owner_epoch=5,
+            token_ids=(10, 11),
+            group_name="group",
+            ports="1234",
+            extra_key=None,
+            token_count=2,
+            bytes_transferred=64,
+            destination_indices=transfer_indices,
+        )
+        self.manager.tier_operations["tier-1"] = BackgroundTierOperation(
+            operation_id="tier-1",
+            operation="shared_import",
+            checkpoint_id="checkpoint-1",
+            agent_id="agent-2",
+            owner_epoch=5,
+            token_ids=(12, 13, 14),
+            extra_key=None,
+            release_gpu=False,
+            token_count=3,
+            bytes_transferred=64,
+            destination_indices=tier_indices,
+        )
+        self.assertEqual(self.manager.reserved_destination_tokens(), 5)
+
+    def test_invalid_shared_checkpoint_id_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, "invalid checkpoint id"):
+            self.manager.start_tier_operation(
+                operation="shared_export",
