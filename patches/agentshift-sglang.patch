+class TestAgentShiftResultAggregation(unittest.TestCase):
+    def test_tp_transfer_waits_for_least_advanced_rank(self):
+        results = [
+            AgentShiftTransferStatusReqOutput(
+                success=True,
+                migration_id="migration-1",
+                state="COMPLETE",
+                role="destination",
+                token_count=4,
+                bytes_transferred=64,
+                transfer_seconds=0.1,
+            ),
+            AgentShiftTransferStatusReqOutput(
+                success=True,
+                migration_id="migration-1",
+                state="COPY_DONE",
+                role="destination",
+                token_count=4,
+                bytes_transferred=64,
+                transfer_seconds=0.2,
+            ),
+        ]
+        merged = aggregate_agentshift_results(
+            results,
+            consistent_fields=("migration_id", "token_count", "role"),
+            sum_fields=("bytes_transferred",),
+            max_fields=("transfer_seconds",),
+            aggregate_state=True,
+        )
+        self.assertEqual(merged.state, "COPY_DONE")
+        self.assertEqual(merged.bytes_transferred, 128)
+        self.assertEqual(merged.transfer_seconds, 0.2)
+
+    def test_tp_failure_is_not_hidden_by_rank_zero_success(self):
+        results = [
+            AgentShiftCleanupTransferReqOutput(success=True, token_count=4),
+            AgentShiftCleanupTransferReqOutput(
+                success=False, message="rank still copying"
+            ),
+        ]
+        merged = aggregate_agentshift_results(
+            results, consistent_fields=("token_count",)
+        )
+        self.assertFalse(merged.success)
+        self.assertEqual(merged.message, "rank still copying")
+
+    def test_tp_metadata_disagreement_fails_closed(self):
+        results = [
+            AgentShiftTransferStatusReqOutput(
+                success=True,
+                migration_id="migration-1",
+                state="COMPLETE",
+                role="destination",
+                token_count=4,
+            ),
+            AgentShiftTransferStatusReqOutput(
+                success=True,
+                migration_id="migration-1",
+                state="COMPLETE",
+                role="destination",
+                token_count=3,
+            ),
+        ]
+        merged = aggregate_agentshift_results(
+            results,
+            consistent_fields=("migration_id", "token_count", "role"),
+            aggregate_state=True,
+        )
+        self.assertFalse(merged.success)
+        self.assertEqual(merged.state, "FAILED")
+        self.assertIn("token_count", merged.message)
