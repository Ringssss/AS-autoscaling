+    def agentshift_tier_cleanup(self, recv_req: AgentShiftTierCleanupReqInput):
+        try:
+            result = self.agent_prefix_manager.cleanup_tier_operation(
+                recv_req.operation_id,
+                drop_checkpoint=recv_req.drop_checkpoint,
+            )
+            local_result = AgentShiftTierCleanupReqOutput(
+                success=True, token_count=result.token_count
+            )
+        except Exception as exc:
+            logger.exception("AgentShift failed to clean tier operation")
+            local_result = AgentShiftTierCleanupReqOutput(
+                success=False, message=str(exc)
+            )
+        return self._agentshift_aggregate_tp(
+            local_result, consistent_fields=("token_count",)
+        )
+
+    def agentshift_release_prefix(self, recv_req: AgentShiftReleasePrefixReqInput):
+        try:
+            result = self.agent_prefix_manager.release(
+                agent_id=recv_req.agent_id,
+                owner_epoch=recv_req.owner_epoch,
+                evict_after_release=recv_req.evict_after_release,
+                allow_missing=recv_req.allow_missing,
+            )
+            local_result = AgentShiftReleasePrefixReqOutput(
+                success=True,
+                token_count=result.token_count,
+                evicted_tokens=result.evicted_tokens,
+            )
+        except Exception as exc:
+            logger.exception("AgentShift failed to release prefix")
+            local_result = AgentShiftReleasePrefixReqOutput(
+                success=False, message=str(exc)
+            )
+        return self._agentshift_aggregate_tp(
+            local_result, consistent_fields=("token_count", "evicted_tokens")
+        )
+
+    def agentshift_rebind_prefix(self, recv_req: AgentShiftRebindPrefixReqInput):
+        try:
+            result = self.agent_prefix_manager.rebind(
+                agent_id=recv_req.agent_id,
+                expected_owner_epoch=recv_req.expected_owner_epoch,
+                new_owner_epoch=recv_req.new_owner_epoch,
+            )
+            local_result = AgentShiftRebindPrefixReqOutput(
+                success=True, token_count=result.token_count
+            )
+        except Exception as exc:
+            logger.exception("AgentShift failed to rebind prefix")
+            local_result = AgentShiftRebindPrefixReqOutput(
+                success=False, message=str(exc)
+            )
+        return self._agentshift_aggregate_tp(
+            local_result, consistent_fields=("token_count",)
+        )
+
     def maybe_sleep_on_idle(self):
         if self.idle_sleeper is not None:
             self.idle_sleeper.maybe_sleep()
