--- /dev/null
+++ b/python/sglang/srt/managers/agentshift_control.py
@@ -0,0 +1,67 @@
+"""Result aggregation helpers for AgentShift control operations."""
+
+from __future__ import annotations
+
+import dataclasses
+from typing import Iterable, Sequence
+
+
+_TRANSFER_STATE_ORDER = {
+    "QUEUED": 0,
+    "COPYING": 1,
+    "COPY_DONE": 2,
+    "INSTALLING": 3,
+    "COMPLETE": 4,
+}
+
+
+def aggregate_agentshift_results(
+    results: Sequence,
+    *,
+    consistent_fields: Iterable[str] = (),
+    sum_fields: Iterable[str] = (),
+    max_fields: Iterable[str] = (),
+    aggregate_state: bool = False,
+):
+    """Merge one AgentShift control result from every participating rank."""
+    if not results:
+        raise ValueError("cannot aggregate an empty AgentShift result set")
+
+    failed = next((result for result in results if not result.success), None)
+    if failed is not None:
+        return failed
+
+    first = results[0]
+    for field in consistent_fields:
+        values = {getattr(result, field) for result in results}
+        if len(values) != 1:
+            changes = {
+                "success": False,
+                "message": f"AgentShift ranks disagree on {field}: {sorted(values)}",
+            }
+            if hasattr(first, "state"):
+                changes["state"] = "FAILED"
+            return dataclasses.replace(first, **changes)
+
+    changes = {
+        field: sum(getattr(result, field) for result in results)
+        for field in sum_fields
+    }
+    changes.update(
+        {
+            field: max(getattr(result, field) for result in results)
+            for field in max_fields
+        }
+    )
+    if aggregate_state:
+        states = [result.state for result in results]
+        unknown = [state for state in states if state not in _TRANSFER_STATE_ORDER]
+        if unknown:
+            return dataclasses.replace(
+                first,
+                success=False,
+                message=f"unknown AgentShift transfer states: {sorted(set(unknown))}",
+                state="FAILED",
+            )
+        changes["state"] = min(states, key=_TRANSFER_STATE_ORDER.__getitem__)
+    return dataclasses.replace(first, **changes)
