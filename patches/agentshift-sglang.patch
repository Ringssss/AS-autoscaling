diff --git a/python/sglang/srt/mem_cache/agent_prefix_cache.py b/python/sglang/srt/mem_cache/agent_prefix_cache.py
new file mode 100644
index 000000000..5ba172bd1
--- /dev/null
+++ b/python/sglang/srt/mem_cache/agent_prefix_cache.py
@@ -0,0 +1,1118 @@
+"""Completed-turn prefix mobility for AgentShift.
+
+This module intentionally does not migrate active requests. It pins an existing
+RadixCache prefix, transfers the corresponding MHA KV rows between identical
+SGLang instances, and installs the copied rows under the same token key.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import queue
+import re
+import threading
+import time
+from array import array
+from dataclasses import dataclass
+from datetime import timedelta
+from typing import Dict, List, Optional
+
+import torch
+import torch.distributed as dist
+
+from sglang.srt.mem_cache.base_prefix_cache import (
+    EvictParams,
+    InsertParams,
+    MatchPrefixParams,
+)
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.utils.common import init_custom_process_group
+from sglang.srt.utils.network import NetworkAddress
+
+logger = logging.getLogger(__name__)
+
+_CHECKPOINT_ID_RE = re.compile(r"^[A-Za-z0-9_.-]+$")
+_SHARED_PREFIX_DIR = "/dev/shm/agentshift-prefixes"
+
+
+@dataclass(slots=True)
+class PinnedAgentPrefix:
+    agent_id: str
+    owner_epoch: int
+    token_ids: tuple[int, ...]
+    kv_indices: torch.Tensor
+    last_node: object
+    extra_key: Optional[str]
+
+
+@dataclass(slots=True)
+class PrefixOperationResult:
+    token_count: int
+    bytes_transferred: int = 0
+    transfer_seconds: float = 0.0
+    evicted_tokens: int = 0
+
+
+@dataclass(slots=True)
+class TransferStatusResult:
+    migration_id: str
+    state: str
+    role: str
+    token_count: int
+    bytes_transferred: int
+    transfer_seconds: float = 0.0
+    queue_seconds: float = 0.0
+    error: Optional[str] = None
+
+
+@dataclass(slots=True)
+class BackgroundTransfer:
+    migration_id: str
+    role: str
+    agent_id: str
+    owner_epoch: int
+    token_ids: tuple[int, ...]
+    group_name: str
+    ports: str
+    extra_key: Optional[str]
+    token_count: int
+    bytes_transferred: int
+    source_indices: Optional[torch.Tensor] = None
+    destination_indices: Optional[torch.Tensor] = None
+    state: str = "QUEUED"
+    queued_at: float = 0.0
+    started_at: float = 0.0
+    finished_at: float = 0.0
+    error: Optional[str] = None
+
+
+@dataclass(slots=True)
+class HostAgentPrefix:
+    checkpoint_id: str
+    agent_id: str
+    owner_epoch: int
+    token_ids: tuple[int, ...]
+    k_layers: tuple[torch.Tensor, ...]
+    v_layers: tuple[torch.Tensor, ...]
+    extra_key: Optional[str]
+
+
+@dataclass(slots=True)
+class BackgroundTierOperation:
+    operation_id: str
+    operation: str
+    checkpoint_id: str
+    agent_id: str
+    owner_epoch: int
+    token_ids: tuple[int, ...]
+    extra_key: Optional[str]
+    release_gpu: bool
+    token_count: int
+    bytes_transferred: int
+    source_indices: Optional[torch.Tensor] = None
+    destination_indices: Optional[torch.Tensor] = None
+    host_prefix: Optional[HostAgentPrefix] = None
+    state: str = "QUEUED"
+    queued_at: float = 0.0
+    started_at: float = 0.0
+    finished_at: float = 0.0
+    error: Optional[str] = None
+
+
+class AgentPrefixManager:
+    """Scheduler-local registry and transfer lifecycle for warm Agent prefixes."""
+
+    def __init__(
+        self,
+        *,
+        tree_cache,
+        token_to_kv_pool_allocator,
+        tp_rank: int,
+        tp_size: int,
+        gpu_id: int,
+    ):
+        self.tree_cache = tree_cache
+        self.allocator = token_to_kv_pool_allocator
+        self.kv_pool = token_to_kv_pool_allocator.get_kvcache()
+        self.tp_rank = tp_rank
+        self.tp_size = tp_size
+        self.gpu_id = gpu_id
+        self.prefixes: Dict[str, PinnedAgentPrefix] = {}
+        self.transfer_groups: Dict[str, dist.ProcessGroup] = {}
+        self.background_transfers: Dict[str, BackgroundTransfer] = {}
+        self.host_prefixes: Dict[str, HostAgentPrefix] = {}
+        self.tier_operations: Dict[str, BackgroundTierOperation] = {}
+        self._transfer_queue: queue.Queue[BackgroundTransfer] = queue.Queue(maxsize=8)
+        self._tier_queue: queue.Queue[BackgroundTierOperation] = queue.Queue(maxsize=8)
+        self._transfer_lock = threading.Lock()
+        self._transfer_worker: Optional[threading.Thread] = None
+        self._transfer_stream: Optional[torch.cuda.Stream] = None
+        self._tier_worker: Optional[threading.Thread] = None
+        self._tier_stream: Optional[torch.cuda.Stream] = None
+
+    def prepare_cache_reset(self) -> bool:
+        """Drop AgentShift metadata immediately before the owning cache resets."""
+        with self._transfer_lock:
+            active_transfers = any(
+                transfer.state not in ("COMPLETE", "FAILED")
+                for transfer in self.background_transfers.values()
+            )
+            active_tier_operations = any(
+                operation.state not in ("COMPLETE", "FAILED")
+                for operation in self.tier_operations.values()
+            )
+            if active_transfers or active_tier_operations:
+                return False
+            self.prefixes.clear()
+            self.background_transfers.clear()
+            self.tier_operations.clear()
+            self.host_prefixes.clear()
+        return True
+
+    def _validate_supported_cache(self) -> None:
+        if not all(
+            hasattr(self.tree_cache, name)
+            for name in ("match_prefix", "insert", "inc_lock_ref", "dec_lock_ref")
+        ):
+            raise RuntimeError("AgentShift requires a RadixCache-compatible prefix cache")
+        if not hasattr(self.kv_pool, "k_buffer") or not hasattr(
+            self.kv_pool, "v_buffer"
+        ):
+            raise RuntimeError("AgentShift PoC currently supports MHA KV pools only")
+        if len(self.kv_pool.k_buffer) != len(self.kv_pool.v_buffer):
+            raise RuntimeError("mismatched K/V layer count")
+
+    def _key(self, token_ids: List[int], extra_key: Optional[str]) -> RadixKey:
+        return RadixKey(array("q", token_ids), extra_key).page_aligned(
+            self.tree_cache.page_size
+        )
+
+    def _bytes_for_tokens(self, token_count: int) -> int:
+        if token_count == 0:
+            return 0
+        per_token = sum(
+            k[0].nbytes + v[0].nbytes
+            for k, v in zip(self.kv_pool.k_buffer, self.kv_pool.v_buffer)
+        )
+        return token_count * per_token
+
+    def pin(
+        self,
+        *,
+        agent_id: str,
+        owner_epoch: int,
+        token_ids: List[int],
+        extra_key: Optional[str] = None,
+    ) -> PrefixOperationResult:
+        self._validate_supported_cache()
+        current = self.prefixes.get(agent_id)
+        if current is not None:
+            same_prefix = (
+                tuple(token_ids[: len(current.token_ids)]) == current.token_ids
+            )
+            if current.owner_epoch == owner_epoch and same_prefix:
+                return PrefixOperationResult(
+                    token_count=len(current.token_ids),
+                    bytes_transferred=self._bytes_for_tokens(len(current.token_ids)),
+                )
+            raise RuntimeError(
+                f"agent {agent_id} is already pinned at epoch {current.owner_epoch}"
+            )
+
+        key = self._key(token_ids, extra_key)
+        match = self.tree_cache.match_prefix(MatchPrefixParams(key=key))
+        token_count = len(match.device_indices)
+        if token_count == 0:
+            raise RuntimeError(f"no resident completed prefix found for agent {agent_id}")
+
+        self.tree_cache.inc_lock_ref(match.last_device_node)
+        self.prefixes[agent_id] = PinnedAgentPrefix(
+            agent_id=agent_id,
+            owner_epoch=owner_epoch,
+            token_ids=tuple(token_ids[:token_count]),
+            kv_indices=match.device_indices.to(dtype=torch.int64, copy=True),
+            last_node=match.last_device_node,
+            extra_key=extra_key,
+        )
+        return PrefixOperationResult(
+            token_count=token_count,
+            bytes_transferred=self._bytes_for_tokens(token_count),
+        )
+
+    def release(
+        self,
+        *,
+        agent_id: str,
+        owner_epoch: int,
+        evict_after_release: bool = True,
+        allow_missing: bool = False,
+    ) -> PrefixOperationResult:
+        prefix = self.prefixes.get(agent_id)
+        if prefix is None:
+            if allow_missing:
+                return PrefixOperationResult(token_count=0)
+            raise KeyError(f"agent prefix is not pinned: {agent_id}")
+        if prefix.owner_epoch != owner_epoch:
+            raise RuntimeError(
+                f"stale prefix release for {agent_id}: got epoch {owner_epoch}, "
+                f"expected {prefix.owner_epoch}"
+            )
+        self.tree_cache.dec_lock_ref(prefix.last_node)
+        del self.prefixes[agent_id]
+        evicted_tokens = 0
+        if evict_after_release:
+            result = self.tree_cache.evict(EvictParams(num_tokens=len(prefix.token_ids)))
+            evicted_tokens = result.num_tokens_evicted
+        return PrefixOperationResult(
+            token_count=len(prefix.token_ids), evicted_tokens=evicted_tokens
+        )
+
+    def rebind(
+        self, *, agent_id: str, expected_owner_epoch: int, new_owner_epoch: int
+    ) -> PrefixOperationResult:
+        prefix = self.prefixes.get(agent_id)
+        if prefix is None:
+            raise KeyError(f"agent prefix is not pinned: {agent_id}")
+        if prefix.owner_epoch == new_owner_epoch:
+            return PrefixOperationResult(token_count=len(prefix.token_ids))
+        if prefix.owner_epoch != expected_owner_epoch:
+            raise RuntimeError(
+                f"stale prefix rebind for {agent_id}: got epoch "
+                f"{expected_owner_epoch}, current is {prefix.owner_epoch}"
+            )
+        if new_owner_epoch <= expected_owner_epoch:
+            raise ValueError("new prefix epoch must increase")
+        prefix.owner_epoch = new_owner_epoch
+        return PrefixOperationResult(token_count=len(prefix.token_ids))
+
+    def init_transfer_group(
+        self,
+        *,
+        master_address: str,
+        ports: str,
+        group_rank: int,
+        world_size: int,
+        group_name: str,
+        backend: str = "nccl",
+    ) -> None:
+        if world_size != 2:
+            raise ValueError("AgentShift warm handoff requires a two-rank transfer group")
+        ports_list = ports.split(",")
+        if len(ports_list) != self.tp_size:
+            raise ValueError(
+                f"expected {self.tp_size} transfer ports, got {len(ports_list)}"
+            )
+        port = int(ports_list[self.tp_rank])
+        key = self._group_key(group_name, ports)
+        if key in self.transfer_groups:
+            return
+        address = NetworkAddress(master_address, port)
+        group = init_custom_process_group(
+            backend=backend,
+            init_method=address.to_tcp(),
+            timeout=timedelta(seconds=120),
+            world_size=world_size,
+            rank=group_rank,
+            group_name=key,
+            device_id=torch.device("cuda", self.gpu_id),
+        )
+        dist.barrier(group=group)
+        self.transfer_groups[key] = group
+        logger.info(
+            "AgentShift initialized transfer group %s for TP rank %d", key, self.tp_rank
+        )
+
+    def _group_key(self, group_name: str, ports: str) -> str:
+        port = ports.split(",")[self.tp_rank]
+        return f"{group_name}_{port}_{self.tp_rank}"
+
+    def _get_group(self, group_name: str, ports: str) -> dist.ProcessGroup:
+        key = self._group_key(group_name, ports)
+        try:
+            return self.transfer_groups[key]
+        except KeyError as exc:
+            raise RuntimeError(f"transfer group is not initialized: {key}") from exc
+
+    def _allocate_destination(self, token_count: int) -> torch.Tensor:
+        indices = self.allocator.alloc(token_count)
+        if indices is not None:
+            return indices.to(dtype=torch.int64)
+        shortage = token_count - self.allocator.available_size()
+        if shortage > 0:
+            self.tree_cache.evict(EvictParams(num_tokens=shortage))
+        indices = self.allocator.alloc(token_count)
+        if indices is None:
+            raise RuntimeError(
+                f"destination cannot reserve {token_count} KV slots; "
+                f"available={self.allocator.available_size()}"
+            )
+        return indices.to(dtype=torch.int64)
+
+    def reserved_destination_tokens(self) -> int:
+        """Return allocated destination slots not yet owned by RadixCache."""
+        with self._transfer_lock:
+            transfer_tokens = sum(
+                len(transfer.destination_indices)
+                for transfer in self.background_transfers.values()
+                if transfer.destination_indices is not None
+            )
+            tier_tokens = sum(
+                len(operation.destination_indices)
+                for operation in self.tier_operations.values()
+                if operation.destination_indices is not None
+            )
+            return transfer_tokens + tier_tokens
+
+    def _ensure_transfer_worker(self) -> None:
+        if self._transfer_worker is not None:
+            return
+        with self._transfer_lock:
+            if self._transfer_worker is not None:
+                return
+            self._transfer_stream = torch.cuda.Stream(device=self.gpu_id)
+            self._transfer_worker = threading.Thread(
+                target=self._transfer_worker_loop,
+                name=f"agentshift-transfer-tp{self.tp_rank}",
+                daemon=True,
+            )
+            self._transfer_worker.start()
+
+    def _transfer_worker_loop(self) -> None:
+        while True:
+            transfer = self._transfer_queue.get()
+            with self._transfer_lock:
+                transfer.state = "COPYING"
+                transfer.started_at = time.perf_counter()
+            try:
+                self._copy_kv_background(transfer)
+            except Exception as exc:
+                logger.exception(
+                    "AgentShift background transfer failed: migration=%s role=%s",
+                    transfer.migration_id,
+                    transfer.role,
+                )
+                with self._transfer_lock:
+                    transfer.error = str(exc)
+                    transfer.finished_at = time.perf_counter()
+                    transfer.state = "FAILED"
+            else:
+                with self._transfer_lock:
+                    transfer.source_indices = None
+                    transfer.finished_at = time.perf_counter()
+                    transfer.state = (
+                        "COPY_DONE" if transfer.role == "destination" else "COMPLETE"
+                    )
+            finally:
+                self._transfer_queue.task_done()
+
+    def _copy_kv_background(self, transfer: BackgroundTransfer) -> None:
+        group = self._get_group(transfer.group_name, transfer.ports)
+        stream = self._transfer_stream
+        assert stream is not None
+        with torch.cuda.device(self.gpu_id), torch.cuda.stream(stream):
+            for k_buffer, v_buffer in zip(
+                self.kv_pool.k_buffer, self.kv_pool.v_buffer
+            ):
+                if transfer.role == "source":
+                    k_staging = k_buffer[transfer.source_indices].contiguous()
+                    v_staging = v_buffer[transfer.source_indices].contiguous()
+                    dist.send(k_staging, dst=1, group=group)
+                    dist.send(v_staging, dst=1, group=group)
+                else:
+                    k_staging = torch.empty(
+                        (transfer.token_count, *k_buffer.shape[1:]),
+                        dtype=k_buffer.dtype,
+                        device=k_buffer.device,
+                    )
+                    v_staging = torch.empty(
+                        (transfer.token_count, *v_buffer.shape[1:]),
+                        dtype=v_buffer.dtype,
+                        device=v_buffer.device,
+                    )
+                    dist.recv(k_staging, src=0, group=group)
+                    dist.recv(v_staging, src=0, group=group)
+                    k_buffer[transfer.destination_indices] = k_staging
+                    v_buffer[transfer.destination_indices] = v_staging
+                del k_staging, v_staging
+        stream.synchronize()
+
+    def start_transfer(
+        self,
+        *,
+        role: str,
+        migration_id: str,
+        agent_id: str,
+        owner_epoch: int,
+        token_ids: List[int],
+        group_name: str,
+        ports: str,
+        extra_key: Optional[str] = None,
+    ) -> TransferStatusResult:
+        self._validate_supported_cache()
+        if role not in ("source", "destination"):
+            raise ValueError(f"invalid transfer role: {role}")
+        self._get_group(group_name, ports)
+        token_count = len(self._key(token_ids, extra_key))
+        if token_count == 0:
+            raise ValueError("cannot transfer an empty prefix")
+        with self._transfer_lock:
+            current = self.background_transfers.get(migration_id)
+            if current is not None:
+                if current.role != role or current.agent_id != agent_id:
+                    raise RuntimeError("migration id is already used by another transfer")
+                return self._transfer_status(current)
+
+        source_indices = None
+        destination_indices = None
+        if role == "source":
+            prefix = self.prefixes.get(agent_id)
+            if prefix is None:
+                raise KeyError(f"source prefix is not pinned: {agent_id}")
+            if prefix.owner_epoch != owner_epoch:
+                raise RuntimeError("source prefix epoch does not match")
+            if prefix.token_ids != tuple(token_ids):
+                raise RuntimeError("source token key changed after pin")
+            source_indices = prefix.kv_indices
+        else:
+            if agent_id in self.prefixes:
+                raise RuntimeError(f"destination already has agent prefix {agent_id}")
+            destination_indices = self._allocate_destination(token_count)
+
+        transfer = BackgroundTransfer(
+            migration_id=migration_id,
+            role=role,
+            agent_id=agent_id,
+            owner_epoch=owner_epoch,
+            token_ids=tuple(token_ids),
+            group_name=group_name,
+            ports=ports,
+            extra_key=extra_key,
+            token_count=token_count,
+            bytes_transferred=self._bytes_for_tokens(token_count),
+            source_indices=source_indices,
+            destination_indices=destination_indices,
+            queued_at=time.perf_counter(),
+        )
+        self._ensure_transfer_worker()
+        with self._transfer_lock:
+            self.background_transfers[migration_id] = transfer
+        try:
+            self._transfer_queue.put_nowait(transfer)
+        except queue.Full:
+            with self._transfer_lock:
+                del self.background_transfers[migration_id]
+            if destination_indices is not None:
+                self.allocator.free(destination_indices)
+            raise RuntimeError("AgentShift transfer queue is full")
+        return self._transfer_status(transfer)
+
+    def _install_destination_prefix(
+        self,
+        *,
+        agent_id: str,
+        owner_epoch: int,
+        token_ids: tuple[int, ...],
+        extra_key: Optional[str],
+        destination_indices: torch.Tensor,
+    ) -> None:
+        token_count = len(token_ids)
+        inserted = False
+        try:
+            key = self._key(list(token_ids), extra_key)
+            insert = self.tree_cache.insert(
+                InsertParams(key=key, value=destination_indices)
+            )
+            inserted = True
+            if insert.prefix_len:
+                self.allocator.free(destination_indices[: insert.prefix_len])
+            match = self.tree_cache.match_prefix(MatchPrefixParams(key=key))
+            if len(match.device_indices) != token_count:
+                raise RuntimeError(
+                    f"installed prefix has {len(match.device_indices)} tokens, "
+                    f"expected {token_count}"
+                )
+            self.tree_cache.inc_lock_ref(match.last_device_node)
+            self.prefixes[agent_id] = PinnedAgentPrefix(
+                agent_id=agent_id,
+                owner_epoch=owner_epoch,
+                token_ids=token_ids,
+                kv_indices=match.device_indices.to(dtype=torch.int64, copy=True),
+                last_node=match.last_device_node,
+                extra_key=extra_key,
+            )
+        except Exception:
+            if not inserted:
+                self.allocator.free(destination_indices)
+            raise
+
+    def _install_background_destination(self, transfer: BackgroundTransfer) -> None:
+        destination_indices = transfer.destination_indices
+        self._install_destination_prefix(
+            agent_id=transfer.agent_id,
+            owner_epoch=transfer.owner_epoch,
+            token_ids=transfer.token_ids,
+            extra_key=transfer.extra_key,
+            destination_indices=destination_indices,
+        )
+        transfer.destination_indices = None
+
+    def poll_transfer(self, migration_id: str) -> TransferStatusResult:
+        with self._transfer_lock:
+            try:
+                transfer = self.background_transfers[migration_id]
+            except KeyError as exc:
+                raise KeyError(f"unknown migration: {migration_id}") from exc
+            should_install = transfer.state == "COPY_DONE"
+            if should_install:
+                transfer.state = "INSTALLING"
+
+        if should_install:
+            try:
+                self._install_background_destination(transfer)
+            except Exception as exc:
+                logger.exception(
+                    "AgentShift destination install failed: migration=%s", migration_id
+                )
+                with self._transfer_lock:
+                    transfer.destination_indices = None
+                    transfer.error = str(exc)
+                    transfer.state = "FAILED"
+            else:
+                with self._transfer_lock:
+                    transfer.state = "COMPLETE"
+        with self._transfer_lock:
+            return self._transfer_status(transfer)
+
+    def cleanup_transfer(self, migration_id: str) -> PrefixOperationResult:
+        with self._transfer_lock:
+            try:
+                transfer = self.background_transfers[migration_id]
+            except KeyError as exc:
+                raise KeyError(f"unknown migration: {migration_id}") from exc
+            if transfer.state not in ("COMPLETE", "FAILED"):
+                raise RuntimeError(
+                    f"cannot clean migration {migration_id} in state {transfer.state}"
+                )
+            destination_indices = transfer.destination_indices
+            transfer.destination_indices = None
+            transfer.source_indices = None
+            del self.background_transfers[migration_id]
+        if destination_indices is not None:
+            self.allocator.free(destination_indices)
+        return PrefixOperationResult(token_count=transfer.token_count)
+
+    def _shared_checkpoint_path(self, checkpoint_id: str) -> str:
+        if not _CHECKPOINT_ID_RE.fullmatch(checkpoint_id):
+            raise ValueError(f"invalid checkpoint id: {checkpoint_id}")
+        return os.path.join(
+            _SHARED_PREFIX_DIR, f"{checkpoint_id}.tp{self.tp_rank}.bin"
+        )
+
+    def _ensure_tier_worker(self) -> None:
+        if self._tier_worker is not None:
+            return
+        with self._transfer_lock:
+            if self._tier_worker is not None:
+                return
+            self._tier_stream = torch.cuda.Stream(device=self.gpu_id)
+            self._tier_worker = threading.Thread(
+                target=self._tier_worker_loop,
+                name=f"agentshift-tier-tp{self.tp_rank}",
+                daemon=True,
+            )
+            self._tier_worker.start()
+
+    def _copy_prefix_to_private_host(
+        self, operation: BackgroundTierOperation
+    ) -> None:
+        stream = self._tier_stream
+        assert stream is not None
+        k_layers = []
+        v_layers = []
+        with torch.cuda.device(self.gpu_id), torch.cuda.stream(stream):
+            for k_buffer, v_buffer in zip(
+                self.kv_pool.k_buffer, self.kv_pool.v_buffer
+            ):
+                k_staging = k_buffer[operation.source_indices].contiguous()
+                v_staging = v_buffer[operation.source_indices].contiguous()
+                k_host = torch.empty(
+                    k_staging.shape,
+                    dtype=k_staging.dtype,
+                    device="cpu",
+                    pin_memory=True,
+                )
+                v_host = torch.empty(
+                    v_staging.shape,
+                    dtype=v_staging.dtype,
+                    device="cpu",
+                    pin_memory=True,
+                )
+                k_host.copy_(k_staging, non_blocking=True)
+                v_host.copy_(v_staging, non_blocking=True)
+                stream.synchronize()
+                k_layers.append(k_host)
+                v_layers.append(v_host)
+                del k_staging, v_staging
+        operation.host_prefix = HostAgentPrefix(
+            checkpoint_id=operation.checkpoint_id,
+            agent_id=operation.agent_id,
+            owner_epoch=operation.owner_epoch,
+            token_ids=operation.token_ids,
+            k_layers=tuple(k_layers),
+            v_layers=tuple(v_layers),
+            extra_key=operation.extra_key,
+        )
+
+    def _copy_private_host_to_prefix(
+        self, operation: BackgroundTierOperation
+    ) -> None:
+        checkpoint = operation.host_prefix
+        assert checkpoint is not None
+        stream = self._tier_stream
+        assert stream is not None
+        with torch.cuda.device(self.gpu_id), torch.cuda.stream(stream):
+            for k_buffer, v_buffer, k_host, v_host in zip(
+                self.kv_pool.k_buffer,
+                self.kv_pool.v_buffer,
+                checkpoint.k_layers,
+                checkpoint.v_layers,
+            ):
+                k_staging = k_host.to(k_buffer.device, non_blocking=True)
+                v_staging = v_host.to(v_buffer.device, non_blocking=True)
+                k_buffer[operation.destination_indices] = k_staging
+                v_buffer[operation.destination_indices] = v_staging
+                stream.synchronize()
+                del k_staging, v_staging
+
+    def _shared_checkpoint_layout(self, token_count: int):
+        dtype = self.kv_pool.k_buffer[0].dtype
+        layout = []
+        offset = 0
+        for k_buffer, v_buffer in zip(
+            self.kv_pool.k_buffer, self.kv_pool.v_buffer
+        ):
+            if k_buffer.dtype != dtype or v_buffer.dtype != dtype:
+                raise RuntimeError("shared checkpoint requires one KV dtype")
+            for buffer in (k_buffer, v_buffer):
+                shape = (token_count, *buffer.shape[1:])
+                numel = token_count
+                for dimension in buffer.shape[1:]:
+                    numel *= dimension
+                layout.append((offset, numel, shape))
+                offset += numel
+        return dtype, layout, offset
+
+    def _export_prefix_to_shared(self, operation: BackgroundTierOperation) -> None:
+        dtype, layout, total_numel = self._shared_checkpoint_layout(
+            operation.token_count
+        )
+        os.makedirs(_SHARED_PREFIX_DIR, mode=0o700, exist_ok=True)
+        path = self._shared_checkpoint_path(operation.checkpoint_id)
+        fd = os.open(path, os.O_CREAT | os.O_TRUNC | os.O_RDWR, 0o600)
+        try:
+            os.ftruncate(fd, total_numel * torch.empty((), dtype=dtype).element_size())
+        finally:
+            os.close(fd)
+        mapped = torch.from_file(path, shared=True, size=total_numel, dtype=dtype)
+        stream = self._tier_stream
+        assert stream is not None
+        position = 0
+        with torch.cuda.device(self.gpu_id), torch.cuda.stream(stream):
+            for k_buffer, v_buffer in zip(
+                self.kv_pool.k_buffer, self.kv_pool.v_buffer
+            ):
+                for buffer in (k_buffer, v_buffer):
+                    offset, numel, shape = layout[position]
+                    staging = buffer[operation.source_indices].contiguous()
+                    mapped[offset : offset + numel].view(shape).copy_(staging)
+                    del staging
+                    position += 1
+        stream.synchronize()
+        del mapped
+
+    def _import_shared_to_prefix(self, operation: BackgroundTierOperation) -> None:
+        dtype, layout, total_numel = self._shared_checkpoint_layout(
+            operation.token_count
+        )
+        path = self._shared_checkpoint_path(operation.checkpoint_id)
+        expected_bytes = total_numel * torch.empty((), dtype=dtype).element_size()
+        if os.path.getsize(path) != expected_bytes:
+            raise RuntimeError(
+                f"shared checkpoint has {os.path.getsize(path)} bytes, "
+                f"expected {expected_bytes}"
+            )
+        mapped = torch.from_file(path, shared=True, size=total_numel, dtype=dtype)
+        stream = self._tier_stream
+        assert stream is not None
+        position = 0
+        with torch.cuda.device(self.gpu_id), torch.cuda.stream(stream):
+            for k_buffer, v_buffer in zip(
+                self.kv_pool.k_buffer, self.kv_pool.v_buffer
+            ):
+                for buffer in (k_buffer, v_buffer):
+                    offset, numel, shape = layout[position]
+                    staging = mapped[offset : offset + numel].view(shape).to(
+                        buffer.device
+                    )
+                    buffer[operation.destination_indices] = staging
+                    del staging
+                    position += 1
+        stream.synchronize()
+        del mapped
+
+    def _tier_worker_loop(self) -> None:
+        while True:
+            operation = self._tier_queue.get()
+            with self._transfer_lock:
+                operation.state = "COPYING"
+                operation.started_at = time.perf_counter()
+            try:
+                if operation.operation == "private_offload":
+                    self._copy_prefix_to_private_host(operation)
+                elif operation.operation == "private_restore":
+                    self._copy_private_host_to_prefix(operation)
+                elif operation.operation == "shared_export":
+                    self._export_prefix_to_shared(operation)
+                elif operation.operation == "shared_import":
+                    self._import_shared_to_prefix(operation)
+                else:
+                    raise ValueError(f"unknown tier operation: {operation.operation}")
+            except Exception as exc:
+                logger.exception(
+                    "AgentShift tier operation failed: operation=%s id=%s",
+                    operation.operation,
+                    operation.operation_id,
+                )
+                with self._transfer_lock:
+                    operation.error = str(exc)
+                    operation.finished_at = time.perf_counter()
+                    operation.state = "FAILED"
+            else:
+                with self._transfer_lock:
+                    operation.source_indices = None
+                    operation.finished_at = time.perf_counter()
+                    operation.state = "COPY_DONE"
+            finally:
+                self._tier_queue.task_done()
+
+    def start_tier_operation(
+        self,
+        *,
+        operation: str,
+        operation_id: str,
+        checkpoint_id: str,
+        agent_id: str,
+        owner_epoch: int,
+        token_ids: List[int],
+        extra_key: Optional[str] = None,
+        release_gpu: bool = True,
+    ) -> TransferStatusResult:
+        self._validate_supported_cache()
+        if operation not in (
+            "private_offload",
+            "private_restore",
+            "shared_export",
+            "shared_import",
+        ):
+            raise ValueError(f"unknown tier operation: {operation}")
+        self._shared_checkpoint_path(checkpoint_id)
+        token_count = len(self._key(token_ids, extra_key))
+        if token_count == 0:
+            raise ValueError("cannot move an empty prefix")
+        with self._transfer_lock:
+            current = self.tier_operations.get(operation_id)
+            if current is not None:
+                if current.operation != operation or current.agent_id != agent_id:
+                    raise RuntimeError("operation id is already used")
+                return self._tier_status(current)
+
+        source_indices = None
+        destination_indices = None
+        host_prefix = None
+        if operation in ("private_offload", "shared_export"):
+            prefix = self.prefixes.get(agent_id)
+            if prefix is None:
+                raise KeyError(f"source prefix is not pinned: {agent_id}")
+            if prefix.owner_epoch != owner_epoch:
+                raise RuntimeError("source prefix epoch does not match")
+            if prefix.token_ids != tuple(token_ids):
+                raise RuntimeError("source token key changed after pin")
+            source_indices = prefix.kv_indices
+        elif operation == "private_restore":
+            if agent_id in self.prefixes:
+                raise RuntimeError(f"engine already has agent prefix {agent_id}")
+            try:
+                host_prefix = self.host_prefixes[checkpoint_id]
+            except KeyError as exc:
+                raise KeyError(f"unknown host checkpoint: {checkpoint_id}") from exc
+            if host_prefix.agent_id != agent_id:
+                raise RuntimeError("host checkpoint belongs to another agent")
+            if host_prefix.owner_epoch != owner_epoch:
+                raise RuntimeError("host checkpoint epoch does not match")
+            if host_prefix.token_ids != tuple(token_ids):
+                raise RuntimeError("host checkpoint token key does not match")
+            destination_indices = self._allocate_destination(token_count)
+        else:
+            if agent_id in self.prefixes:
+                raise RuntimeError(f"engine already has agent prefix {agent_id}")
+            path = self._shared_checkpoint_path(checkpoint_id)
+            if not os.path.exists(path):
+                raise KeyError(f"shared checkpoint is not ready: {checkpoint_id}")
+            destination_indices = self._allocate_destination(token_count)
+
+        tier_operation = BackgroundTierOperation(
+            operation_id=operation_id,
+            operation=operation,
+            checkpoint_id=checkpoint_id,
+            agent_id=agent_id,
+            owner_epoch=owner_epoch,
+            token_ids=tuple(token_ids),
+            extra_key=extra_key,
+            release_gpu=release_gpu,
+            token_count=token_count,
+            bytes_transferred=self._bytes_for_tokens(token_count),
+            source_indices=source_indices,
+            destination_indices=destination_indices,
+            host_prefix=host_prefix,
+            queued_at=time.perf_counter(),
+        )
+        self._ensure_tier_worker()
+        with self._transfer_lock:
+            self.tier_operations[operation_id] = tier_operation
+        try:
+            self._tier_queue.put_nowait(tier_operation)
+        except queue.Full:
+            with self._transfer_lock:
+                del self.tier_operations[operation_id]
+            if destination_indices is not None:
+                self.allocator.free(destination_indices)
+            raise RuntimeError("AgentShift tier queue is full")
+        return self._tier_status(tier_operation)
+
+    def _finalize_tier_operation(self, operation: BackgroundTierOperation) -> None:
+        if operation.operation == "private_offload":
+            assert operation.host_prefix is not None
+            self.host_prefixes[operation.checkpoint_id] = operation.host_prefix
+            if operation.release_gpu:
+                self.release(
+                    agent_id=operation.agent_id,
+                    owner_epoch=operation.owner_epoch,
+                    evict_after_release=True,
+                )
+        elif operation.operation == "shared_export":
+            if operation.release_gpu:
+                self.release(
+                    agent_id=operation.agent_id,
+                    owner_epoch=operation.owner_epoch,
+                    evict_after_release=True,
+                )
+        else:
+            destination_indices = operation.destination_indices
+            self._install_destination_prefix(
+                agent_id=operation.agent_id,
+                owner_epoch=operation.owner_epoch,
+                token_ids=operation.token_ids,
+                extra_key=operation.extra_key,
+                destination_indices=destination_indices,
+            )
+            operation.destination_indices = None
+
+    def poll_tier_operation(self, operation_id: str) -> TransferStatusResult:
+        with self._transfer_lock:
+            try:
+                operation = self.tier_operations[operation_id]
+            except KeyError as exc:
+                raise KeyError(f"unknown tier operation: {operation_id}") from exc
+            should_finalize = operation.state == "COPY_DONE"
+            if should_finalize:
+                operation.state = "INSTALLING"
+
+        if should_finalize:
+            try:
+                self._finalize_tier_operation(operation)
+            except Exception as exc:
+                logger.exception(
+                    "AgentShift tier finalization failed: operation=%s", operation_id
+                )
+                with self._transfer_lock:
+                    operation.destination_indices = None
+                    operation.error = str(exc)
+                    operation.state = "FAILED"
+            else:
+                with self._transfer_lock:
+                    operation.state = "COMPLETE"
+        with self._transfer_lock:
+            return self._tier_status(operation)
+
+    def cleanup_tier_operation(
+        self, operation_id: str, *, drop_checkpoint: bool = False
+    ) -> PrefixOperationResult:
+        with self._transfer_lock:
+            try:
+                operation = self.tier_operations[operation_id]
+            except KeyError as exc:
+                raise KeyError(f"unknown tier operation: {operation_id}") from exc
+            if operation.state not in ("COMPLETE", "FAILED"):
+                raise RuntimeError(
+                    f"cannot clean tier operation {operation_id} in "
+                    f"state {operation.state}"
+                )
+            destination_indices = operation.destination_indices
+            operation.destination_indices = None
+            operation.source_indices = None
+            del self.tier_operations[operation_id]
+            if drop_checkpoint:
+                self.host_prefixes.pop(operation.checkpoint_id, None)
+        if destination_indices is not None:
+            self.allocator.free(destination_indices)
+        if drop_checkpoint:
+            path = self._shared_checkpoint_path(operation.checkpoint_id)
+            try:
+                os.unlink(path)
+            except FileNotFoundError:
+                pass
+        return PrefixOperationResult(token_count=operation.token_count)
+
+    @staticmethod
+    def _tier_status(operation: BackgroundTierOperation) -> TransferStatusResult:
+        queue_seconds = 0.0
+        operation_seconds = 0.0
+        if operation.started_at:
+            queue_seconds = operation.started_at - operation.queued_at
+        if operation.finished_at:
+            operation_seconds = operation.finished_at - operation.started_at
+        return TransferStatusResult(
+            migration_id=operation.operation_id,
+            state=operation.state,
+            role=operation.operation,
+            token_count=operation.token_count,
+            bytes_transferred=operation.bytes_transferred,
+            transfer_seconds=operation_seconds,
+            queue_seconds=queue_seconds,
+            error=operation.error,
+        )
+
+    @staticmethod
+    def _transfer_status(transfer: BackgroundTransfer) -> TransferStatusResult:
+        queue_seconds = 0.0
+        transfer_seconds = 0.0
+        if transfer.started_at:
+            queue_seconds = transfer.started_at - transfer.queued_at
+        if transfer.finished_at:
+            transfer_seconds = transfer.finished_at - transfer.started_at
+        return TransferStatusResult(
+            migration_id=transfer.migration_id,
+            state=transfer.state,
+            role=transfer.role,
+            token_count=transfer.token_count,
+            bytes_transferred=transfer.bytes_transferred,
+            transfer_seconds=transfer_seconds,
+            queue_seconds=queue_seconds,
+            error=transfer.error,
+        )
+
+    def transfer(
+        self,
+        *,
+        role: str,
+        migration_id: str,
+        agent_id: str,
+        owner_epoch: int,
+        token_ids: List[int],
+        group_name: str,
+        ports: str,
+        extra_key: Optional[str] = None,
+    ) -> PrefixOperationResult:
+        self._validate_supported_cache()
+        if role not in ("source", "destination"):
+            raise ValueError(f"invalid transfer role: {role}")
+        group = self._get_group(group_name, ports)
+        token_count = len(self._key(token_ids, extra_key))
+        if token_count == 0:
+            raise ValueError("cannot transfer an empty prefix")
+
+        started = time.perf_counter()
+        destination_indices = None
+        try:
+            if role == "source":
+                prefix = self.prefixes.get(agent_id)
+                if prefix is None:
+                    raise KeyError(f"source prefix is not pinned: {agent_id}")
+                if prefix.owner_epoch != owner_epoch:
+                    raise RuntimeError("source prefix epoch does not match")
+                if prefix.token_ids != tuple(token_ids):
+                    raise RuntimeError("source token key changed after pin")
+                source_indices = prefix.kv_indices
+            else:
+                if agent_id in self.prefixes:
+                    raise RuntimeError(f"destination already has agent prefix {agent_id}")
+                destination_indices = self._allocate_destination(token_count)
+
+            for k_buffer, v_buffer in zip(
+                self.kv_pool.k_buffer, self.kv_pool.v_buffer
+            ):
+                if role == "source":
+                    k_staging = k_buffer[source_indices].contiguous()
+                    v_staging = v_buffer[source_indices].contiguous()
+                    dist.send(k_staging, dst=1, group=group)
+                    dist.send(v_staging, dst=1, group=group)
+                else:
+                    k_staging = torch.empty(
+                        (token_count, *k_buffer.shape[1:]),
+                        dtype=k_buffer.dtype,
+                        device=k_buffer.device,
+                    )
+                    v_staging = torch.empty(
+                        (token_count, *v_buffer.shape[1:]),
+                        dtype=v_buffer.dtype,
+                        device=v_buffer.device,
+                    )
+                    dist.recv(k_staging, src=0, group=group)
+                    dist.recv(v_staging, src=0, group=group)
+                    k_buffer[destination_indices] = k_staging
+                    v_buffer[destination_indices] = v_staging
+                del k_staging, v_staging
+
+            torch.cuda.synchronize(self.gpu_id)
+            dist.barrier(group=group)
+
+            if role == "destination":
+                key = self._key(token_ids, extra_key)
+                insert = self.tree_cache.insert(
+                    InsertParams(key=key, value=destination_indices)
+                )
+                if insert.prefix_len:
+                    self.allocator.free(destination_indices[: insert.prefix_len])
+                match = self.tree_cache.match_prefix(MatchPrefixParams(key=key))
+                if len(match.device_indices) != token_count:
+                    raise RuntimeError(
+                        f"installed prefix has {len(match.device_indices)} tokens, "
+                        f"expected {token_count}"
+                    )
+                self.tree_cache.inc_lock_ref(match.last_device_node)
+                self.prefixes[agent_id] = PinnedAgentPrefix(
+                    agent_id=agent_id,
+                    owner_epoch=owner_epoch,
+                    token_ids=tuple(token_ids),
+                    kv_indices=match.device_indices.to(dtype=torch.int64, copy=True),
+                    last_node=match.last_device_node,
+                    extra_key=extra_key,
+                )
+                destination_indices = None
+        except Exception:
+            if role == "destination" and destination_indices is not None:
+                self.allocator.free(destination_indices)
+            logger.exception(
+                "AgentShift prefix transfer failed: migration=%s role=%s",
+                migration_id,
+                role,
+            )
+            raise
+
+        elapsed = time.perf_counter() - started
+        return PrefixOperationResult(
+            token_count=token_count,
+            bytes_transferred=self._bytes_for_tokens(token_count),
+            transfer_seconds=elapsed,
+        )
